REASONING_MODEL=Qwen/Qwen2.5-14B-Instruct
BULK_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
VECTOR_DB=chroma
INFERENCE_BACKEND=local-transformers
TARGET_PAIR_COUNT=10000
BATCH_SIZE=25
JSONLD_RATIO=0.7
MAX_REFINEMENT_LOOPS=2
RANDOM_SEED=42
VECTOR_INDEX_DIR=artifacts/indexes/chroma
LOCAL_REASONING_MODEL_PATH=/models/Qwen2.5-14B-Instruct
LOCAL_BULK_MODEL_PATH=/models/Qwen2.5-7B-Instruct
LOCAL_EMBEDDING_MODEL_PATH=/models/bge-large-en-v1.5
LOCAL_FILES_ONLY=false
LOCAL_DEVICE=cuda:0
LOCAL_DTYPE=bfloat16
LOCAL_MAX_NEW_TOKENS=1024
LOCAL_PLANNING_MAX_NEW_TOKENS=160
LOCAL_TOP_P=0.9
LOCAL_USE_4BIT=false
LOCAL_TRUST_REMOTE_CODE=false
FAST_MODE=true
ENABLE_LLM_REWRITE=false
ENABLE_LLM_TRANSLATION_HINTS=true
ENABLE_LLM_SEMANTIC_REVIEW=false
GROUNDING_MODE=synthetic_semantic
GROUNDING_SIMILARITY_THRESHOLD=0.2
REQUIRE_MANUAL_REVIEW_FOR_RELEASE=true
RELEASE_SEMANTIC_PASS_THRESHOLD=0.95
RELEASE_SUPPORTED_CLAIM_RATIO_THRESHOLD=0.8
RELEASE_MAX_UNSUPPORTED_CLAIMS_RATIO=0.05
RELEASE_MAX_DUPLICATE_RATIO=0.02
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
OPENAI_BASE_URL=
