FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY requirements.txt requirements-local-gpu.txt pyproject.toml README.md ./
COPY src ./src
COPY tmf921_dataset_gen ./tmf921_dataset_gen
COPY seeds ./seeds
COPY tr290-docs ./tr290-docs
COPY resources ./resources
COPY 921-v5.0.0-ctk-1.0.0 ./921-v5.0.0-ctk-1.0.0
COPY tmf921-v5.0.0-ri-1.0.0 ./tmf921-v5.0.0-ri-1.0.0

RUN python -m pip install --upgrade pip \
    && python -m pip install --extra-index-url https://download.pytorch.org/whl/cu124 torch torchvision torchaudio \
    && python -m pip install -r requirements.txt -r requirements-local-gpu.txt

ENV INFERENCE_BACKEND=local-transformers \
    LOCAL_DEVICE=cuda:0 \
    LOCAL_FILES_ONLY=true

CMD ["python", "-m", "tmf921_dataset_gen.cli", "preflight"]
